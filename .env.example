# Supabase project (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — NEVER exposed to the client, never prefixed with NEXT_PUBLIC_.
# This is the "service_role" secret key (or the new "secret" key format).
# Used by /api/track/* and admin server actions that must bypass RLS safely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: direct Postgres connection string, only needed for local
# `supabase db push` / migration tooling, not read by the app itself.
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used to sign the on-demand ISR revalidation endpoint (/api/revalidate).
REVALIDATE_SECRET=change-me-to-a-random-string

# Google AdSense (optional — leave blank until you have an AdSense account)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
